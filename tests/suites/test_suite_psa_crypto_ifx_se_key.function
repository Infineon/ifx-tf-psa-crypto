/* BEGIN_HEADER */
#include <stdint.h>

#include "psa/crypto.h"
/* END_HEADER */

/* BEGIN_CASE */
void ifx_se_import_sign_local_verify_hash(int key_type_arg,
                                          data_t *private_key,
                                          int alg_arg,
                                          data_t *hash)
{
#if defined(IFX_PSA_SE_DPA_PRESENT)
    psa_key_attributes_t se_attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t local_attributes = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t se_key = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t local_key = MBEDTLS_SVC_KEY_ID_INIT;
    psa_key_type_t key_type = key_type_arg;
    psa_algorithm_t alg = alg_arg;
    uint8_t public_key[PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(
        PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 256)] = { 0 };
    uint8_t signature[PSA_SIGNATURE_MAX_SIZE] = { 0 };
    size_t public_key_length = 0;
    size_t signature_length = 0;

    PSA_ASSERT(psa_crypto_init());

    psa_set_key_lifetime(&se_attributes,
        PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(
            PSA_KEY_PERSISTENCE_VOLATILE, PSA_KEY_LOCATION_IFX_SE));
    psa_set_key_type(&se_attributes, key_type);
    psa_set_key_usage_flags(&se_attributes,
                            PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_EXPORT);
    psa_set_key_algorithm(&se_attributes, alg);
    PSA_ASSERT(psa_import_key(&se_attributes,
                              private_key->x, private_key->len, &se_key));

    PSA_ASSERT(psa_export_public_key(se_key,
                                     public_key, sizeof(public_key),
                                     &public_key_length));

    psa_set_key_type(&local_attributes,
        PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(key_type));
    psa_set_key_usage_flags(&local_attributes, PSA_KEY_USAGE_VERIFY_HASH);
    psa_set_key_algorithm(&local_attributes, alg);
    PSA_ASSERT(psa_import_key(&local_attributes,
                              public_key, public_key_length, &local_key));

    PSA_ASSERT(psa_sign_hash(se_key, alg,
                             hash->x, hash->len,
                             signature, sizeof(signature), &signature_length));
    PSA_ASSERT(psa_verify_hash(local_key, alg,
                               hash->x, hash->len,
                               signature, signature_length));

exit:
    psa_reset_key_attributes(&se_attributes);
    psa_reset_key_attributes(&local_attributes);
    psa_destroy_key(se_key);
    psa_destroy_key(local_key);
    PSA_DONE();
#else
    (void) key_type_arg;
    (void) private_key;
    (void) alg_arg;
    (void) hash;
    mbedtls_test_skip("IFX SE DPA driver is not enabled", __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */

/* BEGIN_CASE */
void ifx_se_import_sign_local_verify_message(int key_type_arg,
                                             data_t *private_key,
                                             int alg_arg,
                                             data_t *message)
{
#if defined(IFX_PSA_SE_DPA_PRESENT)
    psa_key_attributes_t se_attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t local_attributes = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t se_key = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t local_key = MBEDTLS_SVC_KEY_ID_INIT;
    psa_key_type_t key_type = key_type_arg;
    psa_algorithm_t alg = alg_arg;
    uint8_t public_key[PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(
        PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 256)] = { 0 };
    uint8_t signature[PSA_SIGNATURE_MAX_SIZE] = { 0 };
    size_t public_key_length = 0;
    size_t signature_length = 0;

    PSA_ASSERT(psa_crypto_init());
    psa_set_key_lifetime(&se_attributes,
        PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(
            PSA_KEY_PERSISTENCE_VOLATILE, PSA_KEY_LOCATION_IFX_SE));
    psa_set_key_type(&se_attributes, key_type);
    psa_set_key_usage_flags(&se_attributes,
                            PSA_KEY_USAGE_SIGN_MESSAGE |
                            PSA_KEY_USAGE_VERIFY_MESSAGE |
                            PSA_KEY_USAGE_EXPORT);
    psa_set_key_algorithm(&se_attributes, alg);
    PSA_ASSERT(psa_import_key(&se_attributes,
                              private_key->x, private_key->len, &se_key));
    PSA_ASSERT(psa_export_public_key(se_key,
                                     public_key, sizeof(public_key),
                                     &public_key_length));

    psa_set_key_type(&local_attributes,
        PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(key_type));
    psa_set_key_usage_flags(&local_attributes, PSA_KEY_USAGE_VERIFY_MESSAGE);
    psa_set_key_algorithm(&local_attributes, alg);
    PSA_ASSERT(psa_import_key(&local_attributes,
                              public_key, public_key_length, &local_key));

    PSA_ASSERT(psa_sign_message(se_key, alg,
                                message->x, message->len,
                                signature, sizeof(signature), &signature_length));
    PSA_ASSERT(psa_verify_message(se_key, alg,
                                  message->x, message->len,
                                  signature, signature_length));
    PSA_ASSERT(psa_verify_message(local_key, alg,
                                  message->x, message->len,
                                  signature, signature_length));
    signature[0] ^= 1u;
    TEST_EQUAL(psa_verify_message(se_key, alg,
                                  message->x, message->len,
                                  signature, signature_length),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    psa_reset_key_attributes(&se_attributes);
    psa_reset_key_attributes(&local_attributes);
    psa_destroy_key(se_key);
    psa_destroy_key(local_key);
    PSA_DONE();
#else
    (void) key_type_arg;
    (void) private_key;
    (void) alg_arg;
    (void) message;
    mbedtls_test_skip("IFX SE DPA driver is not enabled", __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */
