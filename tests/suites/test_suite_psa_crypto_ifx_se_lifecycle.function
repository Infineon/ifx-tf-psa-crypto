/* BEGIN_HEADER */
#include <stdint.h>
#include <string.h>

#include "psa/crypto.h"
/* END_HEADER */

/* BEGIN_CASE */
void ifx_se_generate_copy_ecdh_destroy(int alg_arg)
{
#if defined(IFX_PSA_SE_DPA_PRESENT) && defined(PSA_WANT_ALG_ECDH)
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t copy_attributes = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t initiator_key = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t responder_key = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t copied_key = MBEDTLS_SVC_KEY_ID_INIT;
    psa_algorithm_t alg = alg_arg;
    uint8_t initiator_public[PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(
        PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 256)] = { 0 };
    uint8_t responder_public[PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(
        PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 256)] = { 0 };
    uint8_t shared_secret_initiator[PSA_BITS_TO_BYTES(256)] = { 0 };
    uint8_t shared_secret_responder[PSA_BITS_TO_BYTES(256)] = { 0 };
    size_t initiator_public_length = 0;
    size_t responder_public_length = 0;
    size_t shared_secret_initiator_length = 0;
    size_t shared_secret_responder_length = 0;

    PSA_ASSERT(psa_crypto_init());

    psa_set_key_lifetime(&attributes,
        PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(
            PSA_KEY_PERSISTENCE_VOLATILE, PSA_KEY_LOCATION_IFX_SE));
    psa_set_key_type(&attributes,
                     PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    psa_set_key_bits(&attributes, 256u);
    psa_set_key_usage_flags(&attributes,
                            PSA_KEY_USAGE_DERIVE |
                            PSA_KEY_USAGE_EXPORT |
                            PSA_KEY_USAGE_COPY);
    psa_set_key_algorithm(&attributes, alg);
    PSA_ASSERT(psa_generate_key(&attributes, &initiator_key));
    PSA_ASSERT(psa_generate_key(&attributes, &responder_key));

    PSA_ASSERT(psa_get_key_attributes(initiator_key, &attributes));
    TEST_EQUAL(PSA_KEY_LIFETIME_GET_LOCATION(
                   psa_get_key_lifetime(&attributes)),
               PSA_KEY_LOCATION_IFX_SE);
    TEST_EQUAL(PSA_KEY_LIFETIME_GET_PERSISTENCE(
                   psa_get_key_lifetime(&attributes)),
               PSA_KEY_PERSISTENCE_VOLATILE);

    psa_set_key_lifetime(&copy_attributes,
        PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(
            PSA_KEY_PERSISTENCE_VOLATILE, PSA_KEY_LOCATION_IFX_SE));
    psa_set_key_usage_flags(&copy_attributes,
                            PSA_KEY_USAGE_DERIVE | PSA_KEY_USAGE_EXPORT);
    psa_set_key_algorithm(&copy_attributes, alg);
    PSA_ASSERT(psa_copy_key(initiator_key, &copy_attributes, &copied_key));

    PSA_ASSERT(psa_export_public_key(initiator_key,
                                     initiator_public,
                                     sizeof(initiator_public),
                                     &initiator_public_length));
    PSA_ASSERT(psa_export_public_key(responder_key,
                                     responder_public,
                                     sizeof(responder_public),
                                     &responder_public_length));
    PSA_ASSERT(psa_raw_key_agreement(alg, copied_key,
                                     responder_public,
                                     responder_public_length,
                                     shared_secret_initiator,
                                     sizeof(shared_secret_initiator),
                                     &shared_secret_initiator_length));
    PSA_ASSERT(psa_raw_key_agreement(alg, responder_key,
                                     initiator_public,
                                     initiator_public_length,
                                     shared_secret_responder,
                                     sizeof(shared_secret_responder),
                                     &shared_secret_responder_length));
    TEST_EQUAL(shared_secret_initiator_length, shared_secret_responder_length);
    TEST_MEMORY_COMPARE(shared_secret_initiator,
                        shared_secret_initiator_length,
                        shared_secret_responder,
                        shared_secret_responder_length);

    PSA_ASSERT(psa_destroy_key(copied_key));
    copied_key = MBEDTLS_SVC_KEY_ID_INIT;
    PSA_ASSERT(psa_destroy_key(initiator_key));
    TEST_ASSERT(psa_export_public_key(initiator_key,
                                      initiator_public,
                                      sizeof(initiator_public),
                                      &initiator_public_length) != PSA_SUCCESS);
    initiator_key = MBEDTLS_SVC_KEY_ID_INIT;

exit:
    psa_reset_key_attributes(&attributes);
    psa_reset_key_attributes(&copy_attributes);
    psa_destroy_key(initiator_key);
    psa_destroy_key(responder_key);
    psa_destroy_key(copied_key);
    PSA_DONE();
#else
    (void) alg_arg;
    mbedtls_test_skip("IFX SE ECDH driver is not enabled", __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */
