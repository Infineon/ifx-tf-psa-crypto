/* BEGIN_HEADER */
#include <stdint.h>

#include "psa/crypto.h"
/* END_HEADER */

/* BEGIN_CASE */
void ifx_se_builtin_sign_local_verify_hash(int alg_arg, data_t *hash)
{
#if defined(TEST_IFX_ADDITIONAL_BUILTIN_KEYS)
    psa_key_attributes_t se_attributes = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t local_attributes = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t se_key = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t local_key = MBEDTLS_SVC_KEY_ID_INIT;
    psa_algorithm_t alg = alg_arg;
    uint8_t public_key[PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(
        PSA_KEY_TYPE_ECC_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 256)] = { 0 };
    uint8_t signature[PSA_SIGNATURE_MAX_SIZE] = { 0 };
    size_t public_key_length = 0;
    size_t signature_length = 0;

    PSA_ASSERT(psa_crypto_init());
    se_key = mbedtls_svc_key_id_make(0, PSA_CRYPTO_IFX_SE_ECDSA_KEY_ID);
    PSA_ASSERT(psa_get_key_attributes(se_key, &se_attributes));
    TEST_EQUAL(PSA_KEY_LIFETIME_GET_LOCATION(
                   psa_get_key_lifetime(&se_attributes)),
               PSA_KEY_LOCATION_IFX_SE);
    TEST_EQUAL(PSA_KEY_LIFETIME_GET_PERSISTENCE(
                   psa_get_key_lifetime(&se_attributes)),
               PSA_KEY_PERSISTENCE_READ_ONLY);

    PSA_ASSERT(psa_export_public_key(se_key,
                                     public_key, sizeof(public_key),
                                     &public_key_length));

    psa_set_key_type(&local_attributes,
        PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(psa_get_key_type(&se_attributes)));
    psa_set_key_usage_flags(&local_attributes, PSA_KEY_USAGE_VERIFY_HASH);
    psa_set_key_algorithm(&local_attributes, alg);
    PSA_ASSERT(psa_import_key(&local_attributes,
                              public_key, public_key_length, &local_key));

    PSA_ASSERT(psa_sign_hash(se_key, alg,
                             hash->x, hash->len,
                             signature, sizeof(signature), &signature_length));
    PSA_ASSERT(psa_verify_hash(local_key, alg,
                               hash->x, hash->len,
                               signature, signature_length));

exit:
    psa_reset_key_attributes(&se_attributes);
    psa_reset_key_attributes(&local_attributes);
    psa_destroy_key(local_key);
    (void) psa_purge_key(se_key);
    PSA_DONE();
#else
    (void) alg_arg;
    (void) hash;
    mbedtls_test_skip("IFX SE built-in key support is not enabled",
                      __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */

/* BEGIN_CASE */
void ifx_se_builtin_aes_round_trip(data_t *plaintext)
{
#if defined(TEST_IFX_ADDITIONAL_BUILTIN_KEYS)
    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = mbedtls_svc_key_id_make(
        0, PSA_CRYPTO_IFX_SE_AES_KEY_ID);
    uint8_t ciphertext[64] = { 0 };
    uint8_t decrypted[64] = { 0 };
    size_t ciphertext_length = 0;
    size_t decrypted_length = 0;

    PSA_ASSERT(psa_crypto_init());
    PSA_ASSERT(psa_get_key_attributes(key, &attributes));
    TEST_EQUAL(PSA_KEY_LIFETIME_GET_LOCATION(
                   psa_get_key_lifetime(&attributes)),
               PSA_KEY_LOCATION_IFX_SE);
    TEST_EQUAL(psa_get_key_type(&attributes), PSA_KEY_TYPE_AES);
    PSA_ASSERT(psa_cipher_encrypt(key, PSA_ALG_CBC_NO_PADDING,
                                  plaintext->x, plaintext->len,
                                  ciphertext, sizeof(ciphertext),
                                  &ciphertext_length));
    PSA_ASSERT(psa_cipher_decrypt(key, PSA_ALG_CBC_NO_PADDING,
                                  ciphertext, ciphertext_length,
                                  decrypted, sizeof(decrypted),
                                  &decrypted_length));
    TEST_EQUAL(decrypted_length, plaintext->len);
    TEST_MEMORY_COMPARE(decrypted, decrypted_length,
                        plaintext->x, plaintext->len);

exit:
    psa_reset_key_attributes(&attributes);
    (void) psa_purge_key(key);
    PSA_DONE();
#else
    (void) plaintext;
    mbedtls_test_skip("IFX SE built-in key support is not enabled",
                      __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */

/* BEGIN_CASE */
void ifx_se_builtin_cmac_round_trip(data_t *input)
{
#if defined(TEST_IFX_ADDITIONAL_BUILTIN_KEYS)
    mbedtls_svc_key_id_t key = mbedtls_svc_key_id_make(
        0, PSA_CRYPTO_IFX_SE_CMAC128_KEY_ID);
    uint8_t mac[PSA_MAC_MAX_SIZE] = { 0 };
    size_t mac_length = 0;

    PSA_ASSERT(psa_crypto_init());
    PSA_ASSERT(psa_mac_compute(key, PSA_ALG_CMAC,
                               input->x, input->len,
                               mac, sizeof(mac), &mac_length));
    PSA_ASSERT(psa_mac_verify(key, PSA_ALG_CMAC,
                               input->x, input->len, mac, mac_length));
    mac[0] ^= 1u;
    TEST_EQUAL(psa_mac_verify(key, PSA_ALG_CMAC,
                               input->x, input->len, mac, mac_length),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    (void) psa_purge_key(key);
    PSA_DONE();
#else
    (void) input;
    mbedtls_test_skip("IFX SE built-in key support is not enabled",
                      __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */

/* BEGIN_CASE */
void ifx_se_builtin_cmac_kdf(data_t *label, data_t *seed)
{
#if defined(TEST_IFX_ADDITIONAL_BUILTIN_KEYS)
    psa_key_derivation_operation_t first_operation = PSA_KEY_DERIVATION_OPERATION_INIT;
    psa_key_derivation_operation_t second_operation = PSA_KEY_DERIVATION_OPERATION_INIT;
    mbedtls_svc_key_id_t key = mbedtls_svc_key_id_make(
        0, PSA_CRYPTO_IFX_SE_CMACKDF_KEY_ID);
    uint8_t first_output[16] = { 0 };
    uint8_t second_output[16] = { 0 };

    PSA_ASSERT(psa_crypto_init());
    PSA_ASSERT(psa_key_derivation_setup(&first_operation,
                                        PSA_ALG_KDF_IFX_SE_AES_CMAC));
    PSA_ASSERT(psa_key_derivation_input_key(
        &first_operation, PSA_KEY_DERIVATION_INPUT_SECRET, key));
    PSA_ASSERT(psa_key_derivation_input_bytes(
        &first_operation, IFX_SE_KEY_DERIVATION_INPUT_LABEL,
        label->x, label->len));
    PSA_ASSERT(psa_key_derivation_input_bytes(
        &first_operation, IFX_SE_KEY_DERIVATION_INPUT_SEED,
        seed->x, seed->len));
    PSA_ASSERT(psa_key_derivation_output_bytes(&first_operation,
                                               first_output,
                                               sizeof(first_output)));

    PSA_ASSERT(psa_key_derivation_setup(&second_operation,
                                        PSA_ALG_KDF_IFX_SE_AES_CMAC));
    PSA_ASSERT(psa_key_derivation_input_key(
        &second_operation, PSA_KEY_DERIVATION_INPUT_SECRET, key));
    PSA_ASSERT(psa_key_derivation_input_bytes(
        &second_operation, IFX_SE_KEY_DERIVATION_INPUT_LABEL,
        label->x, label->len));
    PSA_ASSERT(psa_key_derivation_input_bytes(
        &second_operation, IFX_SE_KEY_DERIVATION_INPUT_SEED,
        seed->x, seed->len));
    PSA_ASSERT(psa_key_derivation_output_bytes(&second_operation,
                                               second_output,
                                               sizeof(second_output)));
    TEST_MEMORY_COMPARE(first_output, sizeof(first_output),
                        second_output, sizeof(second_output));

exit:
    psa_key_derivation_abort(&first_operation);
    psa_key_derivation_abort(&second_operation);
    (void) psa_purge_key(key);
    PSA_DONE();
#else
    (void) label;
    (void) seed;
    mbedtls_test_skip("IFX SE built-in key support is not enabled",
                      __LINE__, __FILE__);
    PSA_DONE();
#endif
}
/* END_CASE */
